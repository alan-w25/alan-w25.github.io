---
import Base from './Base.astro';

export interface Props {
  title: string;
  date: Date;
  description: string;
  slug: string;
}

const { title, date, description, slug } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const ldJson = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "datePublished": date.toISOString(),
  "author": {
    "@type": "Person",
    "name": "Alan Wu",
    "url": "https://alan-w25.github.io"
  },
  "url": `https://alan-w25.github.io/writing/${slug}`
};
---

<Base title={title} description={description} type="article" active={undefined}>
  <script type="application/ld+json" set:html={JSON.stringify(ldJson)} />

  <article class="mt-12">
    <a
      href="/writing"
      class="text-sm transition-colors"
      style="color: #888888; text-decoration: none;"
      onmouseover="this.style.color='#1A1A1A'"
      onmouseout="this.style.color='#888888'"
    >
      ← Back to writing
    </a>

    <h1
      class="font-serif text-4xl font-normal mt-8 mb-3 leading-snug"
      style="color: #1A1A1A;"
      transition:animate="fade"
    >
      {title}
    </h1>
    <time
      datetime={date.toISOString()}
      class="text-sm block mb-12"
      style="color: #888888;"
    >
      {formattedDate}
    </time>

    <div class="prose">
      <slot />
    </div>
  </article>
</Base>
