---
export interface Props {
  active?: 'writing' | 'projects' | 'about';
}
const { active } = Astro.props;

const links = [
  { href: '/writing', label: 'Writing', key: 'writing' },
  { href: '/projects', label: 'Projects', key: 'projects' },
  { href: '/about', label: 'About', key: 'about' },
];
---

<nav class="flex flex-col gap-4 py-8 sm:flex-row sm:items-center sm:justify-between">
  <a href="/" class="font-serif text-lg text-[#1A1A1A] no-underline hover:no-underline" style="text-decoration: none;">
    Alan Wu
  </a>
  <ul class="flex gap-5 list-none m-0 p-0">
    {links.map(link => (
      <li>
        <a
          href={link.href}
          class={`text-sm transition-colors ${
            active === link.key ? 'text-[#1A1A1A] underline underline-offset-4' : 'text-[#888888]'
          } hover:text-[#1A1A1A]`}
          style="text-decoration-color: #1A1A1A;"
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
